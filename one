pipeline {
    agent any

    stages {
        stage('Clone') {
            steps {
                echo 'Cloning'
                git branch: 'main', url: 'https://github.com/devopstraininghub/mindcircuit17d.git'
            }
        }
        stage('Build') {
            steps {
                echo 'Build by maven'
                sh 'mvn clean install'
            }
        }
        stage('deplay') {
            steps {
                echo 'deplay to tomcat'
                deploy adapters: [tomcat9(alternativeDeploymentContext: '', credentialsId: 'tomcat', path: '', url: 'http://ec2-54-81-205-218.compute-1.amazonaws.com:8090/')], contextPath: 'newpipelineproject', war: '**/*.war'
            }
        }
    }
}
